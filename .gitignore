# --- secrets and private data (never commit) ---
data/
logs/
*.key
*.pem
*.sqlite3
.env
*.env

# --- Python ---
__pycache__/
*.py[cod]
.venv*/
venv/

# --- model weights, voices and datasets (large, third-party licences; see models/*/README.md) ---
models/**/*
!models/*/
!models/*/README.md
weights/
demo_data/
*.pt
*.pth
*.onnx
*.zip

# --- generated outputs (only benchmarks/ and eval/ are kept) ---
outputs/*
!outputs/benchmarks/
!outputs/eval/
backups/
submission/_build/html/
submission/_build/generated_report_draft.pdf

# --- editors / OS ---
.vscode/
.idea/
*.code-workspace
Thumbs.db
.DS_Store
desktop.ini
